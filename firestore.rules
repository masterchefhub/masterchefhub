rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email.lower() == 'chrisw81114@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{coll}/{id} {
      allow read: if coll in ['videos','recipes','foods','posts'];
      allow write: if coll in ['videos','recipes','foods','posts'] && isOwner();
    }
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','subject','message','createdAt','by'])
        && request.resource.data.message is string && request.resource.data.message.size() < 4000
        && request.resource.data.name is string && request.resource.data.name.size() < 200;
      allow read, delete: if isOwner();
    }
  }
}
